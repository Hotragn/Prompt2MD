{
  "name": "prompt2md",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade platform and agent skill that converts unstructured text, messy prompts, and complex documents into token-optimized, layout-aware Markdown.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:fresh": "node scripts/test-fresh-install.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vue": "^3.5.13"
  }
}
