{
  "name": "@prompt2md/core",
  "version": "0.1.0",
  "description": "Dual-engine processing pipeline: engine router (docling / markitdown), LiteLLM gateway factory, token-optimization primitives.",
  "license": "Apache-2.0",
  "author": "Hotragn",
  "homepage": "https://prompt2md.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hotragn/Prompt2MD.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Hotragn/Prompt2MD/issues"
  },
  "keywords": [
    "markdown",
    "token-optimization",
    "llm",
    "context-window",
    "pdf-to-markdown",
    "document-conversion",
    "prompt-compression"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "python",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
