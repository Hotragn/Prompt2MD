{
  "name": "@prompt2md/hermes-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Hermes Agent: 4-phase token compression, prompt cache alignment, retrieve_original fallback tool.",
  "license": "Apache-2.0",
