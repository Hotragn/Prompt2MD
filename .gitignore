# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# VitePress
**/.vitepress/cache/
**/.vitepress/dist/

# Python (engine sidecars)
__pycache__/
*.pyc
.venv/
venv/

# Environment & secrets
.env
.env.*
!.env.example

# Test artifacts
coverage/
playwright-report/
test-results/
selenium-screenshots/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local data workspace (real-data test runs, downloads, generated digests)
data/local/
**/data/digests/

# Binary fixtures are generated on demand (fixtures/scripts/make_binary_fixtures.py).
# The repo stays text-only.
fixtures/_generated/

# DSPy optimization artifacts are machine-generated per run.
eval/artifacts/

# Agent skills installed by `npx skills add` — vendored third-party content that
# goes stale. `skills-lock.json` IS tracked (it records source + content hash),
# so the set is reproducible the same way node_modules is: ignore the install,
# commit the lockfile.
.agents/
.claude/skills/
